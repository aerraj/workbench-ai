{
  "name": "workbench-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "prepare:pdf": "node scripts/prepare-pdf.mjs",
    "prebuild": "npm run prepare:pdf",
    "predev": "npm run prepare:pdf",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run db:migrate:remote && WORKBENCH_R2_BUCKET=workbench-files npm run build && wrangler deploy --config dist/server/wrangler.json",
    "setup:local": "node scripts/setup-local.mjs",
    "test:accounts": "node scripts/run-account-tests.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply workbench-accounts --remote --config wrangler.db.json",
    "test:workspace": "node scripts/test-workspace.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.8.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "idb-keyval": "^6.3.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.18.9",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.13.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
